POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+asyncpg://career:replace-with-a-unique-database-password@postgres:5432/career
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
OIDC_SESSION_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=admin@example.com

# Enterprise OIDC / SSO. Leave blank for local accounts only.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_REQUIRE_VERIFIED_EMAIL=true

# Envelope encryption:
# local = development/self-hosted; aws_kms = production example.
KEY_PROVIDER=local
# Set only while rotating data encrypted by Phase 3.
LEGACY_PROFILE_ENCRYPTION_KEY=
LOCAL_CURRENT_KEY_ID=local-v1
LOCAL_MASTER_KEYS_JSON={"local-v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
AZURE_KEY_VAULT_URL=
AZURE_KEY_NAME=career-envelope

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

ONET_API_KEY=
ESCO_BASE_URL=https://ec.europa.eu/esco/api
ESCO_VERSION=1.2.0
ESCO_LANGUAGE=en
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SCHEDULER_ENABLED=false
SYNC_INTERVAL_HOURS=12
CAREER_SEED_TERMS=software engineer,cybersecurity,data analyst,project manager,nurse,teacher
JOB_SEED_TERMS=software engineer,cybersecurity,data analyst,project manager

# Provider credentials should normally be saved per organization through the
# encrypted provider-credential API instead of global environment variables.
LINKEDIN_VERSION=202609


# Phase 5 webhook / worker pipeline
WEBHOOK_MAX_BODY_BYTES=33554432
WEBHOOK_REPLAY_WINDOW_SECONDS=15
WEBHOOK_EVENT_RETENTION_DAYS=30
CANDIDATE_RETENTION_DAYS=365
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Phase 6: consented career-agent monitoring
AGENT_MONITOR_ENABLED=true
AGENT_MONITOR_INTERVAL_MINUTES=15
AGENT_AUTO_ANALYSIS_LIMIT=3
AGENT_DEFAULT_MATCH_THRESHOLD=65
AGENT_CONSENT_VERSION=2026-09
ANALYTICS_RETENTION_DAYS=730

# Phase 6: OpenTelemetry / SIEM
OTEL_ENABLED=false
OTEL_SERVICE_NAME=global-career-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=
DEPLOYMENT_ENVIRONMENT=development
SECURITY_LOG_LEVEL=INFO


# Candidate runs use application OpenTelemetry; disable Agents SDK remote tracing.
OPENAI_AGENTS_DISABLE_TRACING=1

# Phase 7 governance
OPA_URL=
OPA_FAIL_CLOSED=true
PHASE7_FAIRNESS_MIN_GROUP_SIZE=20
PHASE7_EVIDENCE_INTERVAL_HOURS=24


# Phase 8 credential verification
# Optional fixed verifier endpoint for Open Badges / W3C VC proof + status checks.
# Never accept this URL from an end-user request.
CREDENTIAL_REMOTE_VERIFIER_URL=
CREDENTIAL_REMOTE_VERIFIER_TOKEN=

# Learning catalog connectors are allowed to call only these hosts.
# Add enterprise provider domains or your own Open edX host explicitly.
LEARNING_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1
PHASE8_LEARNING_SYNC_HOURS=24

# Labor-market data. BLS Public Data API v2 registration increases query limits.
BLS_API_KEY=
PHASE8_LABOR_MIN_POINTS=4

# Phase 8 portfolio / governance
PHASE8_PORTFOLIO_DEFAULT_SHARE_DAYS=30
PHASE8_EVIDENCE_INTERVAL_HOURS=24

# Phase 9 portable career records and privacy operations
PHASE9_DSAR_DUE_DAYS=30
PHASE9_RETENTION_INTERVAL_HOURS=24
PHASE9_CONTINUOUS_CONTROL_INTERVAL_HOURS=6
PHASE9_PRIVACY_REVIEW_DAYS=365
PHASE9_PORTABLE_RECORD_ISSUER=https://global-career.example/issuers/unsigned-export

# Phase 10 OpenID credential interoperability + privacy engineering
PHASE10_PUBLIC_BASE_URL=http://localhost:8000
PHASE10_ACCESS_TOKEN_SECONDS=600
PHASE10_CREDENTIAL_VALID_DAYS=365
PHASE10_DAILY_EPSILON_LIMIT=2.0

# Optional URL-safe base64 Ed25519 private key seed for signed audit-chain entries.
# Leave blank to keep the hash chain unsigned until a managed signing key is configured.
PHASE10_AUDIT_ED25519_PRIVATE_KEY=
PHASE10_AUDIT_SIGNING_KEY_ID=phase10-audit-v1
PHASE10_PRIVACY_SCAN_HOURS=24
PHASE10_AUDIT_VERIFY_HOURS=6
PHASE10_PROTOCOL_CLEANUP_HOURS=1

# Phase 11
PHASE11_WEBAUTHN_RP_ID=localhost
PHASE11_WEBAUTHN_RP_NAME=Global Career Architecture AI
PHASE11_WEBAUTHN_ORIGINS=http://localhost:5173
PHASE11_WEBAUTHN_CHALLENGE_SECONDS=300
PHASE11_DID_WEB_ALLOWED_HOSTS=
PHASE11_MDOC_VERIFIER_URL=
PHASE11_MDOC_VERIFIER_TOKEN=


# Phase 12 federation / workload identity / HSM / runtime security
PHASE12_FEDERATION_REMOTE_ALLOWED_HOSTS=
PHASE12_FEDERATION_MAX_CHAIN_DEPTH=8
PHASE12_WALLET_ATTESTATION_CLOCK_SKEW_SECONDS=60
PHASE12_REQUIRE_HSM_SIGNING=false
PHASE12_CONFIDENTIAL_INFERENCE_URL=
PHASE12_CONFIDENTIAL_INFERENCE_TOKEN=
PHASE12_CONFIDENTIAL_INFERENCE_ALLOWED_HOSTS=
PHASE12_CONFIDENTIAL_ATTESTATION_MAX_AGE_SECONDS=300
PHASE12_SPIFFE_TRUST_DOMAIN=career.internal
PHASE12_SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
PHASE12_SPIFFE_REQUIRED=false
PHASE12_RUNTIME_SENSOR_TOKEN=
PHASE12_RUNTIME_EVENT_RETENTION_DAYS=90

# Phase 13A — multi-region trust continuity
PHASE13_REGION_ID=local-dev
PHASE13_REGION_NAME=Local Development
PHASE13_REGION_CLOUD=local
PHASE13_REGION_JURISDICTION=
# Remote SPIFFE bundle endpoints must be explicitly allowlisted.
PHASE13_PEER_BUNDLE_ALLOWED_HOSTS=
# Optional external transparency service. Publication is performed by the release pipeline,
# not by arbitrary API requests.
PHASE13_TRANSPARENCY_EXTERNAL_URL=
PHASE13_TRANSPARENCY_EXTERNAL_ALLOWED_HOSTS=rekor.sigstore.dev
PHASE13_TRUST_SNAPSHOT_HOURS=6
PHASE13_TRUST_SNAPSHOT_RETENTION_DAYS=180
# base64url-encoded 32-byte Ed25519 seed; use KMS/HSM in production where possible.
PHASE13_TRUST_SNAPSHOT_ED25519_PRIVATE_KEY=

# Phase 13B — AI security gateway
PHASE13_MODEL_GATEWAY_ALLOWED_MODELS=gpt-5.6
PHASE13_MODEL_GATEWAY_MAX_INPUT_CHARS=50000
PHASE13_MODEL_GATEWAY_MAX_OUTPUT_TOKENS=4000
PHASE13_PROMPT_INJECTION_BLOCK_SCORE=70
PHASE13_CONFIDENTIAL_RAG_MAX_DOCUMENTS=6
PHASE13_AGENT_MANIFEST_REQUIRED=true
# base64url-encoded 32-byte Ed25519 seed for development release manifests.
PHASE13_RELEASE_ED25519_PRIVATE_KEY=
PHASE13_RELEASE_SIGNING_KEY_ID=phase13-release-v1

# Phase 14A — enable only after Alembic 0012, provisioned keys and trust edges.
PHASE14_ENABLED=false
# base64-encoded PEM Ed25519 private key. Keep in secret manager, not Git.
PHASE14_TOKEN_SIGNING_KEY_PEM_B64=
# base64-encoded random >=32-byte master key; managed KMS/HSM recommended.
PHASE14_MEMORY_MASTER_KEY_B64=
# JSON list of explicitly authorized edges: organization_id/source/target/actions.
PHASE14_AGENT_TRUST_EDGES_JSON=[]
# If unset, /metrics returns 404. Supply a strong secret via workload manager.
PHASE14_METRICS_BEARER_TOKEN=
PHASE14_REGION_ID=local-dev
